[debug] [2026-03-27T00:47:21.681Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/sariahrivera/rulesets {"name":"projects/sariahrivera/rulesets/2bb28971-e164-41d9-882d-9c283076a0a4","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /admin_users/{username} {\n      allow get: if true;\n      allow list: if false;\n      allow create, update, delete: if request.auth != null;\n    }\n\n    match /consultas/{document} {\n      allow create: if request.resource.data.keys().hasOnly([\n          \"nombre\",\n          \"telefono\",\n          \"email\",\n          \"servicio\",\n          \"urgencia\",\n          \"canal\",\n          \"mensaje\",\n          \"consentimiento\",\n          \"estado\",\n          \"origen\",\n          \"notas\",\n          \"createdAt\",\n          \"updatedAt\"\n        ])\n        && request.resource.data.nombre is string\n        && request.resource.data.nombre.size() > 1\n        && request.resource.data.telefono is string\n        && request.resource.data.telefono.size() > 5\n        && request.resource.data.servicio is string\n        && request.resource.data.servicio.size() > 1\n        && request.resource.data.urgencia in [\"Alta\", \"Media\", \"Normal\"]\n        && request.resource.data.canal in [\"WhatsApp\", \"Llamada\", \"Correo\"]\n        && request.resource.data.mensaje is string\n        && request.resource.data.mensaje.size() > 10\n        && request.resource.data.email is string\n        && request.resource.data.consentimiento == true\n        && request.resource.data.estado == \"nuevo\"\n        && request.resource.data.origen == \"sitio-web\"\n        && request.resource.data.notas == \"\";\n\n      allow read, update, delete: if request.auth != null;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-03-27T00:47:14.261903Z","metadata":{"services":["cloud.firestore"]}}
